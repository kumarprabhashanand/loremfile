[
  {
    "name": "list_fixtures",
    "title": "List loremfile.dev fixtures",
    "description": "One page of published CC0 sample files in ascending path order, filtered by format, tag and maximum byte count. Reads fixture metadata over the network. Each row includes the URL, SHA-256 and a description. `total` counts every match. Use `next_offset` for the next page. It is null on the last page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Formats to include, any of, e.g. [\"pdf\", \"png\"]. Extension synonyms are jpg/jpeg, tif/tiff, htm/html and yml/yaml. Omit format to list all formats, with the catalogue key in each row's format field."
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Tags to include, any of, e.g. [\"encrypted\"]."
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Only files of at most this size."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250,
          "default": 50,
          "description": "Fixtures per page, 50 unless set, at most 250."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Matches to skip."
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "catalog_version": {
          "type": "string"
        },
        "total": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "count": {
          "type": "integer"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "description": "Catalogue format key, e.g. jpg."
              },
              "mime": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              },
              "sha256": {
                "type": "string",
                "description": "Published SHA-256 of the fixture bytes, as 64 lowercase hexadecimal characters."
              },
              "license": {
                "type": "string",
                "const": "CC0-1.0",
                "description": "CC0 1.0 Universal public domain dedication."
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "url",
              "format",
              "mime",
              "bytes",
              "sha256",
              "license",
              "tags",
              "description"
            ]
          }
        }
      },
      "required": [
        "catalog_version",
        "total",
        "offset",
        "limit",
        "count",
        "next_offset",
        "fixtures"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "describe_fixture",
    "title": "Describe one loremfile.dev fixture",
    "description": "Published metadata for one CC0 fixture, including its URL, MIME type, byte count, SHA-256, tags, description and measured properties. Reads fixture metadata over the network. Fetch the URL for the file.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "A fixture path, e.g. \"pdf/minimal.pdf\"."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "catalog_version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "description": "Catalogue format key, e.g. jpg. Use it to filter list_fixtures."
        },
        "mime": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "const": "CC0-1.0",
          "description": "CC0 1.0 Universal public domain dedication."
        },
        "size_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "How the byte count relates to the nominal size. exact means equal, boundary means exactly one byte above or below, approx means within 5%, and free means the filename makes no size claim. Null if unrecorded."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "props": {
          "type": [
            "object",
            "null"
          ],
          "description": "Properties measured from the fixture bytes. Keys depend on the format and may be absent. Null if no properties are recorded. See https://loremfile.dev/docs/manifest for format-specific keys.",
          "properties": {
            "pages": {
              "type": "integer",
              "description": "Measured PDF page count."
            },
            "width": {
              "type": ["number", "string", "null"],
              "description": "Measured width in pixels for raster images and video. SVG may record its width attribute or null."
            },
            "height": {
              "type": ["number", "string", "null"],
              "description": "Measured height in pixels for raster images and video. SVG may record its height attribute or null."
            },
            "duration_ms": {
              "type": "integer",
              "description": "Measured audio or video duration in milliseconds."
            },
            "rows": {
              "type": "integer",
              "description": "Measured row count. The format determines which rows are included."
            }
          }
        },
        "added_in": {
          "type": [
            "string",
            "null"
          ],
          "description": "Catalogue version that first published the fixture. Null if unrecorded."
        }
      },
      "required": [
        "catalog_version",
        "path",
        "url",
        "format",
        "mime",
        "bytes",
        "sha256",
        "license",
        "size_class",
        "tags",
        "description",
        "props",
        "added_in"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "verify_file",
    "title": "Verify a local copy of a loremfile.dev fixture",
    "description": "Hash a file on this machine and compare it with the published SHA-256 and size of a fixture. Reads the published manifest over the network. `status` is ok, changed or missing. The file is read only to hash it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The fixture path, e.g. \"pdf/minimal.pdf\"."
        },
        "file": {
          "type": "string",
          "description": "The local file: absolute, or relative to where the server was started."
        }
      },
      "required": [
        "path",
        "file"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "changed",
            "missing"
          ]
        },
        "expected_sha256": {
          "type": "string"
        },
        "actual_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_bytes": {
          "type": "integer"
        },
        "actual_bytes": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "file",
        "status",
        "expected_sha256",
        "actual_sha256",
        "expected_bytes",
        "actual_bytes"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
