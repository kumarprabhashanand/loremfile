# Direct dependencies of the loremfile toolchain (docs/06 §9).
#
# Minimum versions are stated only where a feature depends on them; everything else
# floats and is pinned exactly by tools/requirements.lock.
#
# Regenerate the lock inside the image after any change here:
#   pip-compile --generate-hashes --output-file=tools/requirements.lock tools/requirements.in
# and bump tools/TOOLCHAIN_DIGEST in the same pull request — tools/check_lock.sh
# fails the build otherwise (docs/09 §4).

# --- documents -------------------------------------------------------------
fpdf2>=2.8
pypdf>=5
python-docx>=1.2          # comments API
openpyxl
python-pptx

# --- images ----------------------------------------------------------------
